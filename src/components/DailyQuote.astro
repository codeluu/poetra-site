---
import { quoteForDay, quoteDate } from '../lib/dailyQuote';

// Render a complete quote for no-JS clients; refresh in the browser so static
// deployments keep changing daily without requiring another build.
const quote = quoteForDay();
---

<section class="section">
  <figure class="daily-quote reveal" data-daily-quote>
    <p class="kicker">Günün Dizesi</p>
    <blockquote class="daily-quote-text">{quote.text}</blockquote>
    <figcaption class="daily-quote-source">
      <span data-quote-author>{quote.author}</span>
      <span data-quote-source hidden={!quote.source}>{quote.source ? ` · ${quote.source}` : ''}</span>
      <span data-quote-date hidden={!quote.date}>
        {' · '}<time datetime={quote.date}>{quoteDate(quote.date)}</time>
      </span>
    </figcaption>
  </figure>
</section>

<script>
  import { quoteForDay, quoteDate } from '../lib/dailyQuote';

  function updateQuote() {
    const quote = quoteForDay();
    for (const figure of document.querySelectorAll<HTMLElement>('[data-daily-quote]')) {
      figure.querySelector('.daily-quote-text')!.textContent = quote.text;
      figure.querySelector('[data-quote-author]')!.textContent = quote.author;
      const source = figure.querySelector<HTMLElement>('[data-quote-source]')!;
      source.hidden = !quote.source;
      source.textContent = quote.source ? ` · ${quote.source}` : '';
      figure.querySelector<HTMLElement>('[data-quote-date]')!.hidden = !quote.date;
      const time = figure.querySelector('time')!;
      time.dateTime = quote.date;
      time.textContent = quoteDate(quote.date);
    }
  }

  updateQuote();
  document.addEventListener('astro:page-load', updateQuote);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) updateQuote();
  });
  // Also refresh a page left open across midnight (within one minute).
  window.setInterval(updateQuote, 60_000);
</script>
