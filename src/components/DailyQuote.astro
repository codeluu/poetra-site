---
/**
 * DailyQuote — shows one quote per day, picked deterministically at build
 * time. Quotes come from the Sanity "Ana Sayfa" (homePage) settings when
 * provided; otherwise the built-in fallback pool below keeps the block
 * rendering (site must build even with empty settings). No persistence,
 * no client rotation.
 */
import type { DailyQuoteItem } from '../lib/sanity';

type Props = {
  quotes?: DailyQuoteItem[];
};

const fallbackQuotes: DailyQuoteItem[] = [
  {
    text: 'Kelimeler sustuğunda,\nmürekkep konuşmayı sürdürür.',
    source: 'Defterden',
    date: '2025',
  },
  {
    text: 'Her şiir, görünmeyene\naçılan dar bir kapıdır.',
    source: 'Defterden',
    date: '2024',
  },
  {
    text: 'Kâğıt sabırlıdır;\nacele eden benim.',
    source: 'Defterden',
    date: '2025',
  },
];

const { quotes } = Astro.props;
const pool = quotes?.length ? quotes : fallbackQuotes;
const dayIndex = Math.floor(Date.now() / 86_400_000) % pool.length;
const quote = pool[dayIndex];
const attribution = [quote.source, quote.date].filter(Boolean).join(' · ');
---

<section class="section">
  <figure class="daily-quote reveal">
    <p class="kicker">Günün Dizesi</p>
    <blockquote class="daily-quote-text">{quote.text}</blockquote>
    {attribution && <figcaption class="daily-quote-source">{attribution}</figcaption>}
  </figure>
</section>
