---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatLabel, languageLabel } from '../../lib/format';
import { sanityClient, type ContentDocument } from '../../lib/sanity';
import { writingThumbnailUrl } from '../../lib/sanityImage';

const writings = await sanityClient.fetch<ContentDocument[]>(`
  *[
    _type == "writing" &&
    !(_id in path("drafts.**")) &&
    defined(slug.current)
  ]|order(publishedAt desc){
    _id,
    title,
    slug,
    language,
    publishedAt,
    format,
    heroImage { alt, crop, hotspot, asset->{_id, _ref, url, metadata{dimensions, lqip}} },
    "bodyImage": body[_type == "image"][0]{alt, caption, crop, hotspot, "asset": asset->{_id, _ref, url, metadata{dimensions, lqip}}},
    "excerpt": coalesce(seo.description, array::join(body[].children[].text, " ")[0...220]),
    seo
  }
`);
---

<BaseLayout title="Yazılar" description="Poetra yazılar arşivi.">
  <section class="section page-title">
    <h1>Yazılar</h1>
    <p>Denemeler, günlük parçaları ve felsefi sorgular.</p>
  </section>

  <section class="section">
    {
      writings.length ? (
        <ol class="entry-list">
          {writings.map((writing) => (
            <li class="entry">
              <a class="entry-link" href={`/writings/${writing.slug.current}`}>
                <article>
                  <div class="meta">
                    <span>{formatLabel(writing.format)}</span>
                    <span>{languageLabel(writing.language)}</span>
                    <span>{formatDate(writing.publishedAt)}</span>
                  </div>
                  <h2 class="entry-title">{writing.title}</h2>
                  {(writing.heroImage?.asset?.url || writing.bodyImage?.asset?.url) && (
                    <img
                      class="entry-image"
                      src={writingThumbnailUrl(writing.heroImage?.asset?.url ? writing.heroImage : writing.bodyImage)}
                      alt={writing.heroImage?.alt || writing.bodyImage?.alt || `${writing.title} — görsel`}
                      width={1200}
                      height={440}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {writing.excerpt && <p class="entry-excerpt">{writing.excerpt}</p>}
                </article>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">Henüz yazı bulunamadı.</p>
      )
    }
  </section>
</BaseLayout>
