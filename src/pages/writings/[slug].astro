---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatLabel, languageLabel } from '../../lib/format';
import { portableTextToHtml } from '../../lib/portableText';
import { sanityClient, type ContentDocument } from '../../lib/sanity';

export async function getStaticPaths() {
  const writings = await sanityClient.fetch<ContentDocument[]>(`
    *[
      _type == "writing" &&
      !(_id in path("drafts.**")) &&
      defined(slug.current)
    ]|order(publishedAt desc){
      _id,
      title,
      slug,
      language,
      publishedAt,
      "bodyImage": body[_type == "image"][0]{alt},
      heroImage { alt, asset->{_id, url, metadata{dimensions, lqip}} },
      format,
      body[]{
        ...,
        _type == "poemEmbed" && source == "reference" => {
          "poem": poem->{_id, _type, title, slug, originalLanguage, body}
        },
        _type == "image" => { ..., "assetUrl": asset->url }
      },
      seo,
      "excerpt": coalesce(seo.description, array::join(body[].children[].text, " ")[0...220])
    }
  `);

  return writings.map((writing) => ({
    params: { slug: writing.slug.current },
    props: { writing },
  }));
}

const { writing } = Astro.props;
const bodyBlocks = writing.body?.filter(block =>
  !(block._type === 'image' && block.asset &&
    typeof block.asset === 'object' &&
    '_ref' in block.asset &&
    block.asset._ref === writing.heroImage?.asset?._id),
);
const bodyHtml = portableTextToHtml(bodyBlocks);
const contentLang = writing.language === 'en' ? 'en' : 'tr';
const description =
  writing.seo?.description ||
  writing.excerpt ||
  `${writing.title} — Poetra yazılar arşivi.`;
---

<BaseLayout title={writing.seo?.title ?? writing.title} description={description}>
  <article class="article">
    <div class="meta">
      <a href="/writings">Yazılar</a>
      {formatLabel(writing.format) && <span>{formatLabel(writing.format)}</span>}
      {languageLabel(writing.language) && <span>{languageLabel(writing.language)}</span>}
      {writing.publishedAt && <span>{formatDate(writing.publishedAt)}</span>}
    </div>
    <h1>{writing.title}</h1>
    {writing.heroImage?.asset?.url && (
      <img
        class="article-image"
        src={`${writing.heroImage.asset.url}?auto=format&fit=max&w=1600`}
        alt={writing.heroImage.alt || writing.bodyImage?.alt || `${writing.title} — görsel`}
        width={writing.heroImage.asset.metadata?.dimensions?.width}
        height={writing.heroImage.asset.metadata?.dimensions?.height}
        fetchpriority="high"
        decoding="async"
      />
    )}
    {
      bodyHtml ? (
        <div class="portable" lang={contentLang} set:html={bodyHtml} />
      ) : (
        <p class="empty">Bu yazının tam metni yakında burada olacak.</p>
      )
    }
  </article>
</BaseLayout>
