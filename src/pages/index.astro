---
import BaseLayout from '../layouts/BaseLayout.astro';
import DailyQuote from '../components/DailyQuote.astro';
import { formatDate } from '../lib/format';
import {
  sanityClient,
  type ContentSummary,
  type HomePageSettings,
  type HomeWorkCard,
} from '../lib/sanity';

/* Editable homepage settings — singleton "Ana Sayfa" in Sanity Studio.
   Every field is optional; the fallbacks below keep the page identical to
   its current design when the document (or any field) is missing. */
const home = await sanityClient.fetch<HomePageSettings | null>(`
  *[_type == "homePage" && !(_id in path("drafts.**"))][0]{
    heroKicker,
    heroTitle,
    heroTitleEmphasis,
    heroLede,
    dailyQuotes[]{ text, source, date },
    "featured": [
      ...coalesce(featuredPoems[]->{
        _id, _type, title, slug, originalLanguage, publishedAt
      }, []),
      ...coalesce(featuredWritings[]->{
        _id, _type, title, slug, publishedAt
      }, [])
    ][defined(slug.current)],
    shelfHeading,
    works[]{ title, kind, note, url },
    seo
  }
`);

const latest = await sanityClient.fetch<ContentSummary[]>(`
  *[
    _type in ["poetry", "writing", "mediaEntry"] &&
    !(_id in path("drafts.**")) &&
    defined(slug.current)
  ]|order(publishedAt desc)[0...6]{
    _id,
    _type,
    title,
    slug,
    language,
    originalLanguage,
    publishedAt
  }
`);

const counts = await sanityClient.fetch<{ poems: number; writings: number; media: number }>(`
  {
    "poems": count(*[_type == "poetry" && !(_id in path("drafts.**")) && defined(slug.current)]),
    "writings": count(*[_type == "writing" && !(_id in path("drafts.**")) && defined(slug.current)]),
    "media": count(*[_type == "mediaEntry" && !(_id in path("drafts.**")) && defined(slug.current)])
  }
`);

function hrefFor(item: ContentSummary) {
  if (item._type === 'poetry') return `/poetry/${item.originalLanguage}/${item.slug.current}`;
  if (item._type === 'writing') return `/writings/${item.slug.current}`;
  if (item._type === 'mediaEntry') return '/media';
  return '/';
}

const typeLabels: Record<string, string> = {
  poetry: 'Şiir',
  writing: 'Yazı',
  mediaEntry: 'Medya',
};

/* ---- Hero (fallbacks preserve the current copy) ---- */
const heroKicker = home?.heroKicker || 'Poetra — kişisel bir edebiyat arşivi';
const heroLede =
  home?.heroLede ||
  'Şiirler, denemeler, kitaplar ve Muntra Versio’nun müziği — hepsi aynı çatı altında. Acele etmeden okumak için.';

/* Split the editable title around the emphasis phrase so the <em> accent
   survives Studio edits. Falls back to the current hardcoded line. */
let heroTitle = { pre: 'Kelimeler için ', em: 'sakin', post: ' bir mekân.' };
if (home?.heroTitle) {
  const title = home.heroTitle;
  const em = home.heroTitleEmphasis?.trim();
  const at = em ? title.indexOf(em) : -1;
  heroTitle =
    em && at >= 0
      ? { pre: title.slice(0, at), em, post: title.slice(at + em.length) }
      : { pre: title, em: '', post: '' };
}

/* ---- Arşivden: editor-picked items, else latest ---- */
const archiveItems = home?.featured?.length
  ? [...home.featured].sort((a, b) =>
      (b.publishedAt ?? '').localeCompare(a.publishedAt ?? ''),
    )
  : latest;

/* ---- Shelf (books/music) ---- */
const defaultWorks: HomeWorkCard[] = [
  { title: 'Müzisyenin Suç Aleti', kind: 'Kitap', note: 'Detaylar yakında' },
  { title: 'Aykırı Şiirler', kind: 'Kitap', note: 'Detaylar yakında' },
  {
    title: 'Muntra Versio',
    kind: 'Müzik',
    note: 'YouTube ↗',
    url: 'https://www.youtube.com/@MuntraVersio',
  },
];
const shelfHeading = home?.shelfHeading || 'Kitaplar · Müzik';
const workItems = home?.works?.length ? home.works : defaultWorks;

const pageTitle = home?.seo?.title ?? 'Poetra';
const pageDescription =
  home?.seo?.description ?? 'Poetra.art şiir, yazı, müzik ve sorgular arşivi.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero">
    <div class="reveal">
      <p class="kicker">{heroKicker}</p>
      <h1>{heroTitle.pre}{heroTitle.em && <em>{heroTitle.em}</em>}{heroTitle.post}</h1>
      <p class="lede">{heroLede}</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">{counts.poems}</span>
          <span class="stat-label">Şiir</span>
        </div>
        <div class="stat">
          <span class="stat-num">{counts.writings}</span>
          <span class="stat-label">Yazı</span>
        </div>
        <div class="stat">
          <span class="stat-num">{counts.media}</span>
          <span class="stat-label">Medya</span>
        </div>
      </div>
    </div>
  </section>

  <DailyQuote quotes={home?.dailyQuotes} />

  <section class="section">
    <div class="shelf-head reveal">
      <h2 class="kicker">{shelfHeading}</h2>
      <a class="media-link" href="/media">Tüm medya</a>
    </div>
    <div class="shelf-grid">
      {
        workItems.map((work) =>
          work.url ? (
            <a class="work-card reveal" href={work.url} rel="noreferrer">
              <div class:list={['work-cover', { 'work-cover-album': work.kind === 'Müzik' }]}>
                <span class="work-cover-title">{work.title}</span>
              </div>
              <div class="work-kunye">
                {work.kind && <span>{work.kind}</span>}
                {work.note && <span>{work.note}</span>}
              </div>
            </a>
          ) : (
            <article class="work-card reveal">
              <div class:list={['work-cover', { 'work-cover-album': work.kind === 'Müzik' }]}>
                <span class="work-cover-title">{work.title}</span>
              </div>
              <div class="work-kunye">
                {work.kind && <span>{work.kind}</span>}
                {work.note && <span>{work.note}</span>}
              </div>
            </article>
          ),
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="archive-head reveal">
      <h2 class="kicker">Arşivden</h2>
      <a class="media-link" href="/poetry">Tüm şiirler</a>
    </div>
    <ol class="archive-list reveal">
      {
        archiveItems.map((item) => (
          <li class="archive-row">
            <a href={hrefFor(item)}>
              <span class="archive-type">{typeLabels[item._type] ?? item._type}</span>
              <span class="archive-title">{item.title}</span>
              <span class="archive-date">{formatDate(item.publishedAt)}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
